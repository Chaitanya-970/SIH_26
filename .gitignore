data/

# Keep registry.json in git, ignore all other uploaded documents in kb
backend/data/kb/*
!backend/data/kb/registry.json
!backend/data/kb/.gitkeep
backend/data/sessions/*
!backend/data/sessions/.gitkeep
backend/data/chroma/*
!backend/data/chroma/.gitkeep

# Generated deliverables (keep datasets intact)
*.docx
*.xlsx
*.pptx
!datasets/*

# IDEs & System
.vscode/
.idea/
.DS_Store
Thumbs.db

